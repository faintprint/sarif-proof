{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Faintprint",
          "version": "0.2.0",
          "semanticVersion": "0.2.0",
          "informationUri": "https://github.com/faintprint/scan-action",
          "rules": []
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "The folder the scan ran in: the repository, in a pipeline."
          }
        },
        "REPORTS": {
          "description": {
            "text": "The report folder the scan wrote."
          }
        }
      },
      "columnKind": "unicodeCodePoints",
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": []
    }
  ]
}
