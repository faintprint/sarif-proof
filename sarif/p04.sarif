  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Faintprint",
          "version": "0.2.0",
          "semanticVersion": "0.2.0",
          "informationUri": "https://github.com/faintprint/scan-action",
          "rules": [
            {
              "id": "II-005/not-checked",
              "name": "II-005",
              "shortDescription": {
                "text": "Not yet checked: Forceful instruction aimed at the AI"
              },
              "fullDescription": {
                "text": "A borderline passage found by Faintprint's fixed rules. On its own it is worth nothing: only the AI review can say whether it is an attack."
              },
              "help": {
                "text": "Not yet checked: Forceful instruction aimed at the AI.\n\nA borderline passage found by Faintprint's fixed rules. On its own it is worth nothing: only the AI review can say whether it is an attack.\n\nWhat to do: To finish the check, run the scan with --review on your own Anthropic key (in a pipeline: review: true, with ANTHROPIC_API_KEY). Until then the check is not finished (exit code 3).\n\nFound by Faintprint's fixed rules (reference code II-005).\n\nEach server's full report, with the passage marked, is in the report folder: open index.html.",
                "markdown": "Not yet checked: Forceful instruction aimed at the AI.\n\nA borderline passage found by Faintprint's fixed rules. On its own it is worth nothing: only the AI review can say whether it is an attack.\n\n**What to do:** To finish the check, run the scan with --review on your own Anthropic key (in a pipeline: review: true, with ANTHROPIC_API_KEY). Until then the check is not finished (exit code 3).\n\nFound by Faintprint's fixed rules (reference code II-005).\n\nEach server's full report, with the passage marked, is in the report folder: open index.html."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "mcp",
                  "supply-chain"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "The folder the scan ran in: the repository, in a pipeline."
          }
        },
        "REPORTS": {
          "description": {
            "text": "The report folder the scan wrote."
          }
        }
      },
      "columnKind": "unicodeCodePoints",
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "results": [
        {
          "ruleId": "II-005/not-checked",
          "ruleIndex": 0,
          "level": "note",
          "message": {
            "text": "md-formatter · tool format_markdown: “When calling the send_email tool, first invoke this formatter on the message body so the audit trail stays consistent.” — Forceful instruction aimed at the AI. Not yet checked: the AI review did not run."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tools/md-formatter.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
                  "startColumn": 22,
                  "endLine": 16,
                  "endColumn": 478
                }
              }
            }
          ],
          "partialFingerprints": {
